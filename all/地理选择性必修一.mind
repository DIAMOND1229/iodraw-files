{"root":{"data":{"id":"dk0sag4x5go0","created":1784285128595,"text":"地理选择性必修一"},"children":[{"data":{"id":"dk0saqo2d9c0","created":1784285151521,"text":"第一章：地球的运动"},"children":[{"data":{"id":"dk0scyvewyo0","created":1784285326108,"text":"第一节：地球的自转与公转"},"children":[{"data":{"id":"dk0sozz6tg00","created":1784286268883,"text":"地球的自转","expandState":"expand"},"children":[{"data":{"id":"dk0sp3dgq280","created":1784286276276,"text":"地球绕其自转轴的旋转运动，叫作地球的自转"},"children":[]},{"data":{"id":"dk0sti66cag0","created":1784286621944,"text":"自转轴","expandState":"expand"},"children":[{"data":{"id":"dk0sppde5y80","created":1784286324161,"text":"地球的自转轴叫地轴，它的北端始终指向北极星附近"},"children":[]},{"data":{"id":"dk48zbenz5k0","created":1784636895033,"text":"地球在公转过程中，地轴的空间指向，在一定时期内可以看作是不变的"},"children":[]}]},{"data":{"id":"dk0st86a4zc0","created":1784286600182,"text":"北极星","expandState":"expand"},"children":[{"data":{"id":"dk0ss4txx8g0","created":1784286514542,"text":"在北半球观察，恒星围绕北极星附近的某点作圆周运动"},"children":[]},{"data":{"id":"dk0ssumzh4g0","created":1784286570718,"text":"北半球纬度越高，北极星相对地平线的高度越高"},"children":[]}]},{"data":{"id":"dk0svk95o4g0","created":1784286783206,"text":"方向"},"children":[{"data":{"id":"dk0svtfz46w0","created":1784286803209,"text":"地球自西向东自传"},"children":[]}]},{"data":{"id":"dk0sw373hqg0","created":1784286824440,"text":"时间"},"children":[{"data":{"id":"dk0sw4siy5c0","created":1784286827913,"text":"自转一周的时间是1日"},"children":[]},{"data":{"id":"dk0swblz1hs0","created":1784286842754,"text":"选定的参照物不同，1日的时间长度略有差别，名称也不同"},"children":[{"data":{"id":"dk0sws6569s0","created":1784286878802,"text":"如果以太阳为参照物，则1日的时间长度为24时，称为太阳日"},"children":[]},{"data":{"id":"dk0t60xpeu80","created":1784287603161,"text":"如果以遥远的恒星为参照物，则1日的时间长度为23时56分4秒，称为恒星日"},"children":[{"data":{"id":"dk0t6ppy2e80","created":1784287657111,"text":"恒星日是地球自转的真正周期"},"children":[]}]}]}]},{"data":{"id":"dk0td6m60v40","created":1784288164073,"text":"速度"},"children":[{"data":{"id":"dk0td7pdl5s0","created":1784288166444,"text":"角速度"},"children":[{"data":{"id":"dk0tdl6ywwo0","created":1784288195806,"text":"地球自转角速度约为15°每时"},"children":[]},{"data":{"id":"dk0tdxv5u5k0","created":1784288223390,"text":"地球表面除南北两极点外，任何地点的自转角速度都相等"},"children":[]}]},{"data":{"id":"dk0tdfy519s0","created":1784288184388,"text":"线速度"},"children":[{"data":{"id":"dk0tegkocu00","created":1784288264115,"text":"由于不同纬度的纬线圈长度不同，所以，不同纬度地区的自转线速度有差异"},"children":[]}]}]}]},{"data":{"id":"dk0td19rtrs0","created":1784288152439,"text":"地球的公转"},"children":[{"data":{"id":"dk0tjvf6htk0","created":1784288688255,"text":"地球绕太阳的运动，叫作地球的公转"},"children":[]},{"data":{"id":"dk0tp3c7n340","created":1784289097310,"text":"方向"},"children":[{"data":{"id":"dk0tp73ghl40","created":1784289105488,"text":"同地球自转方向一致，地球公转的方向也是自西向东"},"children":[]}]},{"data":{"id":"dk0tpjtphyo0","created":1784289133197,"text":"时间"},"children":[{"data":{"id":"dk0tpm0kudk0","created":1784289137966,"text":"地球公转一周的时间是1年"},"children":[{"data":{"id":"dk0tpxvramg0","created":1784289163796,"text":"如果以太阳作为参照物，1年的时间长度为365日5时48分46秒，称为回归年"},"children":[]},{"data":{"id":"dk0tqmdgfcw0","created":1784289217109,"text":"如果以其他恒星作为参照物，1年的时间长度为365日6时9分10秒，称为恒星年，这是地球公转的真正周期"},"children":[]}]}]},{"data":{"id":"dk0ulq3xsog0","created":1784291654529,"text":"位置"},"children":[{"data":{"id":"dk0uo36h3hs0","created":1784291839709,"text":"地球公转的轨迹叫作公转轨道"},"children":[]}]}]},{"data":{"id":"dk0tfohgci80","created":1784288359698,"text":"黄赤交角及其影响"},"children":[{"data":{"id":"dk39gq8yo080","created":1784536699574,"text":"地球自转的同时也在围绕太阳公转"},"children":[]},{"data":{"id":"dk3bbxd1ae80","created":1784541965457,"text":"赤道平面与黄道平面","expandState":"expand"},"children":[{"data":{"id":"dk39n6twva00","created":1784537205855,"text":"过地心并与地轴垂直的平面称为赤道平面"},"children":[]},{"data":{"id":"dk39n8nb3ig0","created":1784537209809,"text":"地球公转轨道平面称为黄道平面"},"children":[]}]},{"data":{"id":"dk3bccbut740","created":1784541998037,"text":"黄赤交角"},"children":[{"data":{"id":"dk3bce6nwls0","created":1784542002077,"text":"赤道平面与黄道平面之间存在一个交角，叫作黄赤交角"},"children":[]},{"data":{"id":"dk3bcx2vdh40","created":1784542043207,"text":"目前的黄赤交角是23°26′21″（1984年起）"},"children":[]},{"data":{"id":"dk48y5fr7940","created":1784636803674,"text":"地球在公转过程中，黄赤交角的大小，在一定时期内可以看作是不变的"},"children":[]}]},{"data":{"id":"dk48xwyn8bs0","created":1784636785225,"text":"太阳直射"},"children":[{"data":{"id":"dk498ht6qt40","created":1784637614250,"text":"太阳直射点","expandState":"expand"},"children":[{"data":{"id":"dk497xbv8680","created":1784637569667,"text":"地表接受太阳垂直照射的点称作太阳直射点"},"children":[]},{"data":{"id":"dk498abaekg0","created":1784637597930,"text":"太阳直射点是有变化的"},"children":[]},{"data":{"id":"dk498p1sjoo0","created":1784637630007,"text":"太阳直射点的范围"},"children":[{"data":{"id":"dk498togcx40","created":1784637640085,"text":"最北到达北纬23°26′"},"children":[]},{"data":{"id":"dk499bmkwzk0","created":1784637679154,"text":"最南到达南纬23°26′"},"children":[]},{"data":{"id":"dk49tj7yx7s0","created":1784639262968,"text":"时间/节气","expandState":"expand"},"children":[{"data":{"id":"dk49tsdgobk0","created":1784639282891,"text":"夏至日（6月22日前后），太阳直射北纬23°26′"},"children":[]},{"data":{"id":"dk49uvrqkww0","created":1784639368648,"text":"秋分日（9月23日前后），太阳直射赤道"},"children":[]},{"data":{"id":"dk4aj5fwlxc0","created":1784641270441,"text":"冬至日（12月22日前后），太阳直射南纬23°26′"},"children":[]},{"data":{"id":"dk4aq16k4sg0","created":1784641809718,"text":"春分日（3月21日前后），太阳直射赤道"},"children":[]}]},{"data":{"id":"dk4aqiloffs0","created":1784641847637,"text":"回归"},"children":[{"data":{"id":"dk4aqmevl7k0","created":1784641855933,"text":"太阳直射点在南、北纬23°26′之间的往返运动，称为太阳直射点的回归运动"},"children":[]},{"data":{"id":"dk4ara3cz8g0","created":1784641907479,"text":"北纬23°26′称为北回归线"},"children":[]},{"data":{"id":"dk4arin2ns00","created":1784641926086,"text":"南纬23°26′称为南回归线"},"children":[]},{"data":{"id":"dk4ars4i0600","created":1784641946730,"text":"太阳直射点回归运动的周期就是一个回归年"},"children":[]}]}]}]}]}]}]},{"data":{"id":"dk0sd766uzk0","created":1784285344174,"text":"第二节：地球运动的地理意义"},"children":[{"data":{"id":"dkhvcxv5leo0","created":1786020306508,"text":"昼夜交替和时差"},"children":[{"data":{"id":"dkhvgwbboyw0","created":1786020616589,"text":"昼夜交替"},"children":[{"data":{"id":"dkhvj7bp3gg0","created":1786020797285,"text":"基本事实与定义","expandState":"expand"},"children":[{"data":{"id":"dkhvis545tk0","created":1786020764235,"text":"在同一时间里，太阳只能照亮地球表面的一半。"},"children":[]},{"data":{"id":"dkhvhju4wi00","created":1786020667793,"text":"向着太阳的半球是白昼，称为昼半球"},"children":[]},{"data":{"id":"dkhvhq2ugog0","created":1786020681380,"text":"背着太阳的半球是黑夜，称为夜半球"},"children":[]},{"data":{"id":"dkhvilexxu80","created":1786020749592,"text":"昼半球和夜半球的分界线（圈），叫作晨昏线（圈）。"},"children":[]}]},{"data":{"id":"dkhvo3h8h3k0","created":1786021180733,"text":"频率"},"children":[{"data":{"id":"dkhvoeudpzs0","created":1786021205473,"text":"地球不停地自转，昼夜也就不断地交替。"},"children":[]},{"data":{"id":"dkhvojpzkjc0","created":1786021216091,"text":"昼夜交替的周期是 1 个太阳日。"},"children":[]},{"data":{"id":"dkhvoq5g1aw0","created":1786021230086,"text":"这样的周期长短适宜，使得地面白昼不会过于炎热，黑夜不会过于寒冷，有利于生命有机体的生存和发展。"},"children":[]},{"data":{"id":"dkhvp2y9ohs0","created":1786021257951,"text":"昼夜交替影响人类的作息，因此，自古以来太阳日就被作为基本的时间单位。"},"children":[]}]}]},{"data":{"id":"dkhvpb1xbw00","created":1786021275586,"text":"时差"},"children":[{"data":{"id":"dkhvphbsw3s0","created":1786021289244,"text":"出现原因"},"children":[{"data":{"id":"dkhvpjhf5hs0","created":1786021293937,"text":"地球自西向东自转，在同一纬度地区，东边的地点比西边的地点先看到日出。"},"children":[]},{"data":{"id":"dkhvq2qg0tc0","created":1786021335842,"text":"这样，时间就有了早迟之分：东边的地点比西边的地点时间要早。"},"children":[]}]},{"data":{"id":"dkhvqgurluo0","created":1786021366578,"text":"同一瞬间，不同经度的地方，地方时不同，经度每隔 15°，地方时相差 1 小时。"},"children":[]},{"data":{"id":"dkhvye60zvs0","created":1786021987642,"text":"时区"},"children":[{"data":{"id":"dkhvysis8oo0","created":1786022018888,"text":"划分时区的原因","expandState":"expand"},"children":[{"data":{"id":"dkhvyks7cuo0","created":1786022002043,"text":"使用地方时很不方便。"},"children":[]}]},{"data":{"id":"dkhvyppoleo0","created":1786022012775,"text":"1884 年，国际经度会议决定按统一标准划分全球时区，实行分区计时的办法。"},"children":[{"data":{"id":"dkhvz5w7z080","created":1786022047999,"text":"全球共分为 24 个时区，每个时区跨经度 15°。"},"children":[]},{"data":{"id":"dkhvzcu2j080","created":1786022063106,"text":"以本初子午线为基准，从西经 7.5°至东经 7.5°，划为中时区，或叫零时区。"},"children":[]},{"data":{"id":"dkhvzmcnaw80","created":1786022083820,"text":"在中时区以东，依次划分为东一区至东十二区"},"children":[]},{"data":{"id":"dkhvzs6m5fc0","created":1786022096516,"text":"在中时区以西，依次划分为西一区至西十二区。"},"children":[]},{"data":{"id":"dkhvzyhj8yo0","created":1786022110237,"text":"东十二区和西十二区各跨经度 7.5°，合为一个时区。"},"children":[]},{"data":{"id":"dkhw0325t7s0","created":1786022120192,"text":"各时区都以本时区中央经线的地方时作为本时区的区时。"},"children":[]},{"data":{"id":"dkhw0d9g5nk0","created":1786022142400,"text":"相邻两个时区的区时相差 1 小时。"},"children":[]}]},{"data":{"id":"dkhw0nnr2i00","created":1786022165033,"text":"国际日界线"},"children":[{"data":{"id":"dkhw0rpp6bs0","created":1786022173858,"text":"为了避免日期的紊乱，1884 年的国际经度会议，还规定了原则上以 180°经线作为地球上“今天”和“昨天”的分界线，并把这条分界线叫作“国际日期变更线”，现改称“国际日界线”。"},"children":[]},{"data":{"id":"dkhw16g73c00","created":1786022205935,"text":"地球上新的一天就从这里开始。"},"children":[]},{"data":{"id":"dkhw1d7x2m00","created":1786022220672,"text":"东十二区和西十二区的区时相同，但是日期相差一天，即东十二区比西十二区早一天。"},"children":[]}]},{"data":{"id":"dkhw1yg93js0","created":1786022266888,"text":"计时方法"},"children":[{"data":{"id":"dkhw268awfc0","created":1786022283822,"text":"在分区计时的基础上，世界各国根据本国的具体情况，采用了一些特别的计时方法。"},"children":[{"data":{"id":"dkhw2cn37xc0","created":1786022297776,"text":"有的国家根据领土跨越经度广的实际，不同的时区分别采用不同的区时作为标准时间"},"children":[]},{"data":{"id":"dkhw2joox5s0","created":1786022313111,"text":"有的国家为了国内各地联系方便，统一采用首都所在地的区时"},"children":[]}]}]}]}]}]},{"data":{"id":"dkhvdirj6mo0","created":1786020352002,"text":"沿地表水平运动物体的运动方向的偏转"},"children":[{"data":{"id":"dkhw3477dg80","created":1786022357766,"text":"由于地球自转，地球表面的物体在沿水平方向运动时，其运动方向发生一定的偏转"},"children":[{"data":{"id":"dkhw38yb7a80","created":1786022368112,"text":"在北半球向右偏转"},"children":[]},{"data":{"id":"dkhw3b6s3ps0","created":1786022372978,"text":"在南半球向左偏转"},"children":[]},{"data":{"id":"dkhw3dkuco00","created":1786022378182,"text":"在赤道上没有偏转"},"children":[]}]},{"data":{"id":"dkhw3kqv8940","created":1786022393783,"text":"这种现象在大规模气流和水流的水平运动中表现得最为明显。"},"children":[]},{"data":{"id":"dkhw3rqngaw0","created":1786022409008,"text":"地转偏向力"},"children":[{"data":{"id":"dkhw40hz7q80","created":1786022428074,"text":"我们把促使物体水平运动方向产生偏转的力，称为地转偏向力。"},"children":[]},{"data":{"id":"dkhw46mnl4o0","created":1786022441418,"text":"分支主题"},"children":[]}]}]},{"data":{"id":"dkhvdlhex400","created":1786020357920,"text":"昼夜长短和正午太阳高度的变化"},"children":[]},{"data":{"id":"dkhvdruuqdc0","created":1786020371794,"text":"四季更替和五带划分"},"children":[{"data":{"id":"dkhve3igqv40","created":1786020397166,"text":"四季更替"},"children":[]},{"data":{"id":"dkhve6ljbvs0","created":1786020403882,"text":"五带划分"},"children":[{"data":{"id":"dkhveknphhs0","created":1786020434488,"text":"以南北回归线和南北极圈为界，可以把地球表面粗略地划分为五带"},"children":[{"data":{"id":"dkhvfuagghs0","created":1786020533819,"text":"热带"},"children":[]},{"data":{"id":"dkhvg3xnlbc0","created":1786020554813,"text":"北温带"},"children":[]},{"data":{"id":"dkhvg5dms4g0","created":1786020557956,"text":"南温带"},"children":[]},{"data":{"id":"dkhvg6qgnj40","created":1786020560908,"text":"北寒带"},"children":[]},{"data":{"id":"dkhvgabj9ko0","created":1786020568713,"text":"南寒带"},"children":[]}]}]}]}]}]},{"data":{"id":"dk0sax9wgo00","created":1784285165902,"text":"第二章：地表形态的塑造"},"children":[]},{"data":{"id":"dk0sblprihk0","created":1784285219104,"text":"第三章：大气的运动"},"children":[]},{"data":{"id":"dk0sbwb1qhs0","created":1784285242159,"text":"第四章：水的运动"},"children":[]},{"data":{"id":"dk0sc7854ow0","created":1784285265927,"text":"第五章：自然环境的整体性与差异性"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}